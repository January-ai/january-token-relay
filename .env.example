# Both values are entered once, at the Vercel deploy prompt. Nothing else is
# required.

# Your January Developer API key (sk-…). Server-side only — this is the secret
# the relay exists to keep off phones. Mint one at https://dashboard.january.ai
JANUARY_API_KEY=

# A secret you invent (long and random). Your app sends it to this relay to
# request tokens. Rotate it here any time without touching your API key.
RELAY_TOKEN=

# ——— Optional ———————————————————————————————————————————————————————————————

# Narrow what minted tokens may do (comma-separated). Default: all scopes.
# TOKEN_SCOPES=foods:read,food_scans:write

# Token lifetime in seconds, 300–7200. Default: 1800.
# TOKEN_TTL_SECONDS=1800

# Web builds only — origins allowed to call the relay from a browser.
# ALLOWED_ORIGINS=http://localhost:3000

# Point at a different January environment (January-internal use).
# JANUARY_BASE_URL=https://partners.january.ai
