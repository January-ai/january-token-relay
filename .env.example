# ——— Required ———————————————————————————————————————————————————————————————

# Your January Developer API key (sk-…). Server-side only — this is the secret
# the relay exists to keep off phones. Mint one at the developer dashboard.
JANUARY_API_KEY=

# Which login system your app already uses:
#   firebase | clerk | auth0 | supabase | jwt | shared-secret
AUTH_PROVIDER=

# ——— Provider settings (fill the block for YOUR provider) ———————————————————

# firebase
FIREBASE_PROJECT_ID=

# clerk — the instance issuer, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# CLERK_AUDIENCE=            # only if your JWT template sets one

# auth0
AUTH0_DOMAIN=                # e.g. acme.us.auth0.com
AUTH0_AUDIENCE=              # your API identifier

# supabase
SUPABASE_URL=                # e.g. https://abcd1234.supabase.co
# SUPABASE_JWT_SECRET=       # classic projects; omit to use the project's JWKS

# jwt (any other login system that issues signed JWTs)
# JWKS_URL=
# JWT_ISSUER=
# JWT_AUDIENCE=
# USER_CLAIM=sub

# shared-secret (BETA BUILDS ONLY — see README warning before using)
# RELAY_SHARED_SECRET=

# ——— Optional relay policy ——————————————————————————————————————————————————

# Narrow what minted tokens may do (comma-separated). Default: all scopes.
# TOKEN_SCOPES=foods:read,food_scans:write

# Token lifetime in seconds, 300–7200. Default: 1800.
# TOKEN_TTL_SECONDS=1800

# Web builds only — origins allowed to call the relay from a browser.
# ALLOWED_ORIGINS=http://localhost:3000

# Point at a different January environment (January-internal use).
# JANUARY_BASE_URL=https://partners.january.ai
