# Running locally: ./start.sh fills this in for you. By hand: copy this file to
# .env, paste your API key, then `npm start`. Deploying to Vercel: enter both
# values at the deploy prompt.
#
# This relay is for development and testing. Before launch, move the endpoint
# into your backend behind your real user authentication — see the README.

# Your January Developer API key (sk-…). Server-side only — this is the secret
# the relay exists to keep off phones. Mint one at https://dashboard.january.ai
JANUARY_API_KEY=

# A secret you invent (long and random). Your app sends it as the
# "Authorization: Bearer <RELAY_TOKEN>" header when requesting tokens from
# this relay. Required on Vercel, and whenever other devices can reach the
# relay (HOST=0.0.0.0 — ./start.sh generates one then). On your own machine
# nothing else can reach the relay, so no token is needed or checked.
RELAY_TOKEN=

# ——— Optional ———————————————————————————————————————————————————————————————

# Narrow what minted tokens may do (comma-separated). Unset, the relay asks for
# every scope so you can exercise the whole SDK: foods:read, food_analysis:write,
# food_logs:read, food_logs:write, glucose:read, restaurants:read. Narrow it
# before any beta.
# TOKEN_SCOPES=foods:read,food_logs:write

# Token lifetime in seconds, 300–7200. Default: 1800.
# TOKEN_TTL_SECONDS=1800

# Web builds only — origins allowed to call the relay from a browser.
# ALLOWED_ORIGINS=http://localhost:3000

# Local runs only — port and bind address. HOST=0.0.0.0 opens the relay to your
# Wi-Fi so a physical phone can reach it (see "Run it locally" in the README).
# PORT=8787
# HOST=127.0.0.1

# Point at a different January environment (January-internal use).
# JANUARY_BASE_URL=https://partners.january.ai
